# ==============================================================================
# RPDevs-Builds APK_Build-Patch - Keystore & Signing Environment Template
# ==============================================================================
# Copy this file to `signing.env` or configure secrets in GitHub Actions:
# Repository Secrets:
#   KEYSTORE_BASE64       - Base64 encoded keystore (.keystore or .jks)
#   KEYSTORE_PASSWORD     - Keystore password
#   KEY_ALIAS             - Key entry alias
#   KEY_PASSWORD          - Key entry password
#   GITHUB_TOKEN          - GitHub Personal Access Token or workflow GITHUB_TOKEN
#   TELEGRAM_BOT_TOKEN    - (Optional) Telegram bot token for release broadcasts
#   TELEGRAM_CHAT_ID      - (Optional) Telegram chat ID or channel @username
#   DISCORD_WEBHOOK_URL   - (Optional) Discord Webhook URL for release notifications
#   GPLAY_EMAIL           - (Optional) Google account email for Google Play Store API
#   GPLAY_TOKEN           - (Optional) Google Play Store auth/app token
# ==============================================================================

KEYSTORE_PATH="bin/keystores/ks.keystore"
KEYSTORE_PASSWORD="pass:123456789"
KEY_ALIAS="jhc"
KEY_PASSWORD="pass:123456789"
